<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".PracticalTest01MainActivity">

    <!-- Câmpul Text Stânga (A.2) -->
    <EditText
        android:id="@+id/left_text_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textAlignment="center"
        android:focusable="false"
        android:clickable="false"
        android:inputType="none"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_text_field"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <!-- Câmpul Text Dreapta (A.2) -->
    <EditText
        android:id="@+id/right_text_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textAlignment="center"
        android:focusable="false"
        android:clickable="false"
        android:inputType="none"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_text_field"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Buton Stânga (A.2) -->
    <Button
        android:id="@+id/left_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Press Me!"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/left_text_field"
        app:layout_constraintStart_toStartOf="@+id/left_text_field"
        app:layout_constraintEnd_toEndOf="@+id/left_text_field" />

    <!-- Buton Dreapta (A.2) -->
    <Button
        android:id="@+id/right_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Press Me, Too!"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/right_text_field"
        app:layout_constraintStart_toStartOf="@+id/right_text_field"
        app:layout_constraintEnd_toEndOf="@+id/right_text_field" />

</androidx.constraintlayout.widget.ConstraintLayout>
